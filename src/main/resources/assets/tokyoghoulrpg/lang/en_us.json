  "command.tokyoghoulrpg.help.0": "§c§lTokyo Ghoul RPG: команды§r (в [скобках] можно указать игрока, иначе действует на тебя)",
  "command.tokyoghoulrpg.help.1": "§e/tgrpg info [игрок]§r — класс, очки, ярость, навыки, задание",
  "command.tokyoghoulrpg.help.2": "§e/tgrpg points add|set|remove <число> [игрок]§r — очки навыков",
  "command.tokyoghoulrpg.help.3": "§e/tgrpg blood add|set|remove <число> [игрок]§r — очки крови",
  "command.tokyoghoulrpg.help.4": "§e/tgrpg class <human|ghoul|half_ghoul|ccg_agent> [игрок]§r — сменить класс (как инъекцией)",
  "command.tokyoghoulrpg.help.5": "§e/tgrpg variant <kaneki|author> [игрок]§r — вариант кагуне",
  "command.tokyoghoulrpg.help.6": "§e/tgrpg rage <0-100> [игрок]§r — очки ярости",
  "command.tokyoghoulrpg.help.7": "§e/tgrpg ragelevel <0-5> [игрок]§r — уровень прокачки ярости",
  "command.tokyoghoulrpg.help.8": "§e/tgrpg skills reset [игрок]§r — снять все навыки и вернуть очки",
  "command.tokyoghoulrpg.help.9": "§e/tgrpg skills unlockall [игрок]§r — открыть всё дерево бесплатно",
  "command.tokyoghoulrpg.help.10": "§e/tgrpg quests complete [игрок]§r — засчитать текущее задание с наградой",
  "command.tokyoghoulrpg.help.11": "§e/tgrpg quests reset [игрок]§r — начать задания сначала (награды выдадутся снова)",
  "command.tokyoghoulrpg.help.12": "§e/tgrpg cooldowns reset [игрок]§r — сбросить откаты способностей",
  "command.tokyoghoulrpg.help.13": "§e/tgrpg reset [игрок]§r — сбросить персонажа полностью и выбрать класс заново",
  "command.tokyoghoulrpg.help.14": "§e/tgrpg craving <0-100> [игрок]§r — шкала «Кровь» (жажда крови гуля)",
